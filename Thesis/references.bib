@inproceedings{kumarComprehensiveStudyImpact2024,
  title = {A {{Comprehensive Study}} on the {{Impact}} of {{Vulnerable Dependencies}} on {{Open-Source Software}}},
  booktitle = {2024 {{IEEE}} 35th {{International Symposium}} on {{Software Reliability Engineering}} ({{ISSRE}})},
  author = {Kumar, Shree Hari Bittugondanahalli Indra and Sampaio, L{\'i}lia Rodrigues and Martin, Andr{\'e} and Brito, Andrey and Fetzer, Christof},
